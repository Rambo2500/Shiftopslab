{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-to-code/contracts/core/audit_log.schema.json",
  "title": "AuditPolicy",
  "description": "Audit policy requirements for high-stakes intents. Defines append-only, hash-chained logging expectations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "append_only": { "type": "boolean", "const": true },
    "hash_chain": { "type": "boolean", "const": true },
    "log_fields_required": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "timestamp_utc",
          "actor",
          "action",
          "resource_id",
          "result",
          "policy_version",
          "decision_id",
          "intent_hash",
          "artifact_hash",
          "prev_hash",
          "hash"
        ]
      },
      "minItems": 5
    }
  },
  "required": ["append_only", "hash_chain", "log_fields_required"]
}
